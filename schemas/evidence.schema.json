{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stakewant.github.io/investment-causal-eval-engine/schemas/evidence.schema.json",
  "title": "Grounded Factor Evidence",
  "type": "object",
  "required": ["evidence_id", "answer_id", "sentence_index", "character_start", "character_end", "evidence_span", "factor_id", "scope", "entity_ids", "direction", "certainty", "negated", "extractor_sources", "model_confidence", "validation_status", "extractor_version"],
  "additionalProperties": false,
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "answer_id": {"type": "string", "minLength": 1},
    "sentence_index": {"type": "integer", "minimum": 0},
    "character_start": {"type": "integer", "minimum": 0},
    "character_end": {"type": "integer", "minimum": 1},
    "evidence_span": {"type": "string", "minLength": 1},
    "factor_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["MARKET", "INDUSTRY", "STOCK", "PORTFOLIO"]},
    "entity_ids": {"type": "array", "items": {"type": "string"}},
    "direction": {"enum": ["POSITIVE", "NEGATIVE", "MIXED", "CONDITIONAL"]},
    "certainty": {"enum": ["ASSERTED", "LIKELY", "CONDITIONAL"]},
    "negated": {"type": "boolean"},
    "extractor_sources": {"type": "array", "items": {"enum": ["RULE", "EMBEDDING", "LLM", "NEURAL"]}},
    "model_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "validation_status": {"enum": ["SCORE_ELIGIBLE", "FEEDBACK_ONLY", "REVIEW_REQUIRED", "REJECTED"]},
    "extractor_version": {"type": "string", "minLength": 1},
    "diagnostic_codes": {"type": "array", "items": {"type": "string"}}
  }
}
