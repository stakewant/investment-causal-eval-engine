{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stakewant.github.io/investment-causal-eval-engine/schemas/relation_evidence.schema.json",
  "title": "Relation Evidence",
  "type": "object",
  "required": [
    "relation_evidence_id",
    "source_evidence_id",
    "target_evidence_id",
    "relation",
    "sign",
    "connector_span",
    "sentence_distance",
    "explicitness",
    "model_confidence",
    "matched_edge_ids",
    "validation_status",
    "relation_extractor_version"
  ],
  "additionalProperties": false,
  "properties": {
    "relation_evidence_id": {"type": "string", "minLength": 1},
    "source_evidence_id": {"type": "string", "minLength": 1},
    "target_evidence_id": {"type": "string", "minLength": 1},
    "relation": {"enum": ["CAUSES", "INCREASES", "DECREASES", "AMPLIFIES", "MITIGATES", "EXPOSES", "PRICES_IN", "CONDITIONAL_ON", "UNRELATED"]},
    "sign": {"enum": ["POSITIVE", "NEGATIVE", "MIXED", "CONDITIONAL"]},
    "connector_span": {"type": "string"},
    "sentence_distance": {"type": "integer", "minimum": 0},
    "explicitness": {"enum": ["EXPLICIT", "IMPLICIT"]},
    "model_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "matched_edge_ids": {"type": "array", "items": {"type": "string"}},
    "validation_status": {"enum": ["SCORE_ELIGIBLE", "FEEDBACK_ONLY", "REVIEW_REQUIRED", "REJECTED"]},
    "relation_extractor_version": {"type": "string", "minLength": 1}
  }
}

